+    /**
+     * SSRF 防护: 仅允许公网 HTTP(S) 目标地址
+     * 拒绝回环、内网、链路本地、CGNAT(含阿里云元数据 100.100.100.200)、保留及组播地址
+     * 对应 CVE-2026-7025 (Ping Back Service Endpoint sendPingHandle)
+     *
+     * @param string $url 目标 URL
+     * @return bool
+     */
+    private function isSafeRemoteUrl(string $url)
+    {
+        $urlPart = parse_url((string) $url);
+
+        if (empty($urlPart['scheme']) || empty($urlPart['host'])) {
+            return false;
+        }
+
+        if (!in_array(strtolower($urlPart['scheme']), ['http', 'https'])) {
+            return false;
+        }
+
+        $host = strtolower($urlPart['host']);
+
+        if ('localhost' == $host || '.local' == substr($host, -6)) {
+            return false;
+        }
+
+        if (function_exists('idn_to_ascii')) {
+            $host = idn_to_ascii($host, IDNA_DEFAULT, INTL_IDNA_VARIANT_UTS46);
+
+            if (false === $host) {
+                return false;
+            }
+
+            $host = strtolower($host);
+        }
+
+        if (filter_var($host, FILTER_VALIDATE_IP)) {
+            $ips = [$host];
+        } else {
+            $ips = @gethostbynamel($host);
+
+            if (empty($ips)) {
+                return false;
+            }
+        }
+
+        foreach ((array) $ips as $ip) {
+            if (false !== strpos($ip, ':')) {
+                if (in_array($ip, ['::1', '::'])) {
+                    return false;
+                }
+
+                if (0 === strpos($ip, 'fe80') || 0 === strpos($ip, 'fc') || 0 === strpos($ip, 'fd')) {
+                    return false;
+                }
+
+                continue;
+            }
+
+            $long = ip2long($ip);
+
+            if (
+                false === $long
+                || false === filter_var(
+                    $ip,
+                    FILTER_VALIDATE_IP,
+                    FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE
+                )
+            ) {
+                return false;
+            }
+
+            if (self::isCgnatOrReserved($long)) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    /**
+     * 是否属于 CGNAT (100.64.0.0/10) 或保留/组播段 (0/8, 224/4, 240/4)
+     *
+     * @param int $long ip2long 值
+     * @return bool
+     */
+    private static function isCgnatOrReserved(int $long): bool
+    {
+        $octets = explode('.', long2ip($long));
+
+        if ('100' == $octets[0] && (int) $octets[1] >= 64 && (int) $octets[1] <= 127) {
+            return true;
+        }
+
+        return 0 == (int) $octets[0] || (int) $octets[0] >= 224;
+    }

+    /**
+     * 保存用户上传的头像文件
+     *
+     * @param array $file
+     * @return string|false
+     */
+    private function saveAvatarUpload(array $file)
+    {
+        if (
+            ($file['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK
+            || empty($file['tmp_name'])
+            || !is_uploaded_file($file['tmp_name'])
+            || ($file['size'] ?? 0) > 2 * 1024 * 1024
+        ) {
+            return false;
+        }
+
+        $imageInfo = @getimagesize($file['tmp_name']);
+        $mimeToExtension = [
+            'image/jpeg' => 'jpg',
+            'image/png' => 'png',
+            'image/gif' => 'gif',
+            'image/webp' => 'webp'
+        ];
+        $mime = is_array($imageInfo) ? ($imageInfo['mime'] ?? '') : '';
+        if (!isset($mimeToExtension[$mime])) {
+            return false;
+        }
+
+        $uploadDir = defined('__TYPECHO_UPLOAD_DIR__') ? __TYPECHO_UPLOAD_DIR__ : Upload::UPLOAD_DIR;
+        $uploadRoot = defined('__TYPECHO_UPLOAD_ROOT_DIR__') ? __TYPECHO_UPLOAD_ROOT_DIR__ : __TYPECHO_ROOT_DIR__;
+        $relativeDir = rtrim($uploadDir, '/') . '/avatars/' . (int) $this->user->uid;
+        $absoluteDir = rtrim($uploadRoot, '/') . $relativeDir;
+        if (!is_dir($absoluteDir) && !@mkdir($absoluteDir, 0755, true)) {
+            return false;
+        }
+
+        try {
+            $fileName = bin2hex(random_bytes(16)) . '.' . $mimeToExtension[$mime];
+        } catch (\Throwable $exception) {
+            return false;
+        }
+
+        $absolutePath = $absoluteDir . '/' . $fileName;
+        if (!@move_uploaded_file($file['tmp_name'], $absolutePath)) {
+            return false;
+        }
+        @chmod($absolutePath, 0644);
+
+        $relativePath = $relativeDir . '/' . $fileName;
+        $baseUrl = defined('__TYPECHO_UPLOAD_URL__') ? __TYPECHO_UPLOAD_URL__ : $this->options->siteUrl;
+        return Common::url($relativePath, $baseUrl);
+    }
+
     /**
      * 执行更新动作
      *

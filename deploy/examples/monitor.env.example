# Copy to /etc/typecho-suite/monitor.env and restrict it to the collector user.
STATE_DIR=/var/lib/typecho-suite/monitor
LOG=/var/log/nginx/access.log
CNF=/etc/typecho-suite/monitor-rw.cnf
MONITOR_DB=monitor

# Space-separated systemd units to include in the status snapshot.
SERVICE_UNITS="nginx php-fpm mysqld"

# Optional local HTTP probes. Each item is key=host:port; the key must match
# the optional display-name and URL JSON configured in SuiteMonitor.
SITE_TARGETS="blog=blog.example.com:80 docs=docs.example.com:80"

# Leave owner/group empty when the PHP worker can already read STATE_DIR.
# Otherwise set the group to the web-server group, such as www-data or nginx.
STATUS_OWNER=root
STATUS_GROUP=www-data
STATUS_MODE=0640

# Required by the monitor panel for its read-only database connection.
MONITOR_RO_USER=replace-with-readonly-user
MONITOR_RO_PASS=replace-with-readonly-password

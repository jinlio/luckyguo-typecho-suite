{
  "name": "luckyguo/typecho-suite",
  "description": "Reusable, configurable Typecho theme and plugins.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "classmap": [
      "plugins/",
      "deploy/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "TypechoSuite\\Tests\\": "tests/Unit/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform-check": true
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "lint": "php -l deploy/suite-doctor.php"
  }
}
